{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "paths": {
      "@nexcrm/shared-types": [
        "../../packages/shared-types/src"
      ],
      "@nexcrm/service-common/*": [
        "../../packages/service-common/src/*"
      ]
    },
    "rootDirs": [
      "src",
      "../../packages/shared-types/src",
      "../../packages/service-common/src"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
