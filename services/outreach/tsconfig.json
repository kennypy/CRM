{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDirs": [
      "src",
      "../../packages/shared-types/src",
      "../../packages/service-common/src"
    ],
    "paths": {
      "@nexcrm/service-common/*": [
        "../../packages/service-common/src/*"
      ],
      "@nexcrm/shared-types": [
        "../../packages/shared-types/src"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
